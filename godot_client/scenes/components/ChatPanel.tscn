[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/components/ChatPanel.gd" id="1"]

[node name="ChatPanel" type="VBoxContainer"]
custom_minimum_size = Vector2(360, 400)
theme_override_constants/separation = 6
script = ExtResource("1")

[node name="Header" type="Label" parent="."]
layout_mode = 2
text = "Balance Agent"
theme_override_font_sizes/font_size = 16

[node name="Scroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
follow_focus = true

[node name="Log" type="RichTextLabel" parent="Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
selection_enabled = true

[node name="InputRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Input" type="LineEdit" parent="InputRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Ask the agent to build, adjust, or rebalance..."

[node name="SendButton" type="Button" parent="InputRow"]
unique_name_in_owner = true
layout_mode = 2
